# ===================================================
# .env.example — NeXT-TeCH Freshman Hub
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env to git.
# ===================================================

# ── Telegram Bot ──────────────────────────────────
# Get from @BotFather → /mybots → API Token
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Your Telegram numeric chat ID (run the bot, type /start, check logs for your chat_id)
ADMIN_CHAT_ID=YOUR_NUMERIC_TELEGRAM_CHAT_ID

# ── Payment Account Details ───────────────────────
TELEBIRR_NUMBER=0964549757
CBE_ACCOUNT=1000591061155
ACCOUNT_HOLDER_NAME=Nahom J.

# ── Private Channel IDs (negative numbers) ────────
# Forward a message from each channel to @userinfobot to get the ID.
# WARNING: If sem1 and sem2 are DIFFERENT channels, use two different IDs!
CHANNEL_SEM1_ID=-1001234567890
CHANNEL_SEM2_ID=-1009876543210


# ── Optional: Public Announcements Channel ────────
ANNOUNCEMENTS_CHANNEL=https://t.me/YourPublicChannel

# ── Database path override (for Render persistent disk) ──
# Leave empty for local development (uses bot/data/ by default).
# On Render, set this to the disk mountPath in render.yaml.
DATA_DIR=

# ── Node Environment ──────────────────────────────
NODE_ENV=production
